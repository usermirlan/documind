# Copy to .env (never commit .env)
SECRET_KEY=change-me-to-a-long-random-string

# Answers: any OpenAI-compatible chat API. Free key: https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Embeddings: "local" (bundled multilingual model, no key) or "gemini"
EMBED_PROVIDER=local
# Only for EMBED_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
